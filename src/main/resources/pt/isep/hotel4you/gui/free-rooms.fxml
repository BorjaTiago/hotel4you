<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="screen" spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.isep.hotel4you.gui.FreeRoomController">

    <Label text="Quartos livres" styleClass="section-title"/>
    <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="card">
        <HBox spacing="12" alignment="BOTTOM_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Tipo" labelFor="$typeBox"/>
                <ComboBox fx:id="typeBox" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Entrada" labelFor="$startPicker"/>
                <DatePicker fx:id="startPicker" editable="false" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Saída" labelFor="$endPicker"/>
                <DatePicker fx:id="endPicker" editable="false" maxWidth="Infinity"/>
            </VBox>
            <Button text="Procurar" onAction="#onSearchClicked" styleClass="primary-button" minWidth="120"/>
        </HBox>
        <TableView fx:id="roomTable" VBox.vgrow="ALWAYS" prefWidth="500">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="numberColumn" text="Número" prefWidth="110"/>
                <TableColumn fx:id="floorColumn" text="Piso" prefWidth="100"/>
                <TableColumn fx:id="roomTypeColumn" text="Tipo" prefWidth="160"/>
                <TableColumn fx:id="priceColumn" text="Preço por noite" prefWidth="160"/>
                <TableColumn fx:id="totalColumn" text="Total" prefWidth="160"/>
            </columns>
            <placeholder>
                <Label text="Escolha o tipo e as datas e clique em Procurar."/>
            </placeholder>
        </TableView>
    </VBox>
    <!-- Footer: message on the left, next step on the right -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Label fx:id="messageLabel" styleClass="message" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"
               visible="${messageLabel.text != ''}"/>
        <Button text="Escolher quarto →" onAction="#onChooseRoomClicked" styleClass="next-button"
                minWidth="-Infinity"/>
    </HBox>
</VBox>
