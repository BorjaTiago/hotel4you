<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="app-view, screen" spacing="12" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.isep.hotel4you.gui.CardPlacesController">
    <Label text="Locais de um cartão" styleClass="subtitle"/>
    <Label fx:id="cardNumberLabel" text="Número do cartão"/>
    <HBox spacing="10">
        <TextField fx:id="cardNumberField" promptText="Ex.: 12345" onAction="#onSearchClicked" HBox.hgrow="ALWAYS"/>
        <Button text="Consultar" onAction="#onSearchClicked" styleClass="primary-button"/>
    </HBox>
    <TableView fx:id="entryTable" styleClass="data-table" VBox.vgrow="ALWAYS" prefWidth="600">
        <columns>
            <TableColumn fx:id="placeColumn" text="Local" prefWidth="300"/>
            <TableColumn fx:id="timeColumn" text="Hora da entrada" prefWidth="210"/>
        </columns>
        <placeholder><Label text="Escreva o número do cartão e clique em Consultar."/></placeholder>
    </TableView>
    <Label fx:id="messageLabel" styleClass="message" wrapText="true" maxWidth="Infinity"/>
</VBox>
