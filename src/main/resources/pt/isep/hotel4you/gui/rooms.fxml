<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="screen" spacing="12" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.isep.hotel4you.gui.RoomController">

    <Label text="Quartos" styleClass="subtitle"/>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Tipo" labelFor="$filterBox"/>
        <ComboBox fx:id="filterBox" prefWidth="180"/>
    </HBox>
    <Label fx:id="summaryLabel" wrapText="true"/>
    <TableView fx:id="roomTable" VBox.vgrow="ALWAYS" prefWidth="500">
        <columns>
            <TableColumn fx:id="numberColumn" text="Número" prefWidth="120"/>
            <TableColumn fx:id="floorColumn" text="Piso" prefWidth="160"/>
            <TableColumn fx:id="roomTypeColumn" text="Tipo" prefWidth="160"/>
            <TableColumn fx:id="basePriceColumn" text="Preço base por noite" prefWidth="180"/>
        </columns>
        <placeholder>
            <Label text="Não há quartos."/>
        </placeholder>
    </TableView>
    <VBox fx:id="formBox" spacing="12">
        <HBox spacing="12">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Número do quarto" labelFor="$numberField"/>
                <TextField fx:id="numberField" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Piso" labelFor="$floorBox"/>
                <ComboBox fx:id="floorBox" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Tipo de quarto" labelFor="$roomTypeBox"/>
                <ComboBox fx:id="roomTypeBox" maxWidth="Infinity"/>
            </VBox>
        </HBox>
        <HBox spacing="12">
            <Button text="Registar quarto" onAction="#onSaveRoomClicked" styleClass="action-button, save-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Guardar alterações" onAction="#onSaveRoomChangesClicked" styleClass="action-button, edit-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Remover quarto" onAction="#onRemoveRoomClicked" styleClass="action-button, danger-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Button text="Limpar" onAction="#onClearClicked" styleClass="action-button, clear-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>
    <Label fx:id="messageLabel" styleClass="message" wrapText="true" maxWidth="Infinity"/>
</VBox>
