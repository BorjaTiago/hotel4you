<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="screen, reservation-screen" spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.isep.hotel4you.gui.ReservationController">

    <Label text="Nova reserva" styleClass="page-title"/>

    <TabPane fx:id="tabPane" styleClass="steps" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <!-- Step 1: choose the client -->
        <Tab text="1. Cliente">
            <fx:include fx:id="clientStep" source="client.fxml"/>
        </Tab>

        <!-- Step 2: choose the room and the dates -->
        <Tab fx:id="roomTab" text="2. Quarto" disable="true">
            <fx:include fx:id="roomStep" source="free-rooms.fxml"/>
        </Tab>

        <!-- Step 3: check the data and confirm -->
        <Tab fx:id="confirmTab" text="3. Confirmar" disable="true">
            <VBox styleClass="screen" spacing="12">
                <VBox styleClass="summary-card" spacing="6">
                    <Label fx:id="clientLabel" wrapText="true" maxWidth="Infinity"/>
                    <Label fx:id="roomLabel" wrapText="true" maxWidth="Infinity"/>
                    <Label fx:id="datesLabel" wrapText="true" maxWidth="Infinity"/>
                    <Label fx:id="summaryLabel" wrapText="true" maxWidth="Infinity"/>
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="summary-footer">
                        <Label fx:id="totalLabel" styleClass="summary-total" wrapText="true" maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"/>
                        <Button fx:id="confirmButton" text="Confirmar reserva ✓" onAction="#onCreateReservationClicked"
                                styleClass="next-button" minWidth="-Infinity"/>
                    </HBox>
                </VBox>
                <Label fx:id="messageLabel" styleClass="message" wrapText="true" maxWidth="Infinity"
                       visible="${messageLabel.text != ''}" managed="${messageLabel.text != ''}"/>

                <!-- Reservations of the client, with the cancelled ones -->
                <VBox VBox.vgrow="ALWAYS" styleClass="card">
                    <TableView fx:id="reservationTable" accessibleText="Reservas do cliente"
                               VBox.vgrow="ALWAYS" prefHeight="160">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="roomColumn" text="Quarto" prefWidth="110"/>
                            <TableColumn fx:id="startColumn" text="Entrada" prefWidth="150"/>
                            <TableColumn fx:id="endColumn" text="Saída" prefWidth="150"/>
                            <TableColumn fx:id="statusColumn" text="Estado" prefWidth="180"/>
                        </columns>
                        <placeholder>
                            <Label text="O cliente não tem reservas."/>
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
