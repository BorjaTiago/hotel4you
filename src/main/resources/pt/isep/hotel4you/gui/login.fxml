<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" prefWidth="320" styleClass="login-box" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.isep.hotel4you.gui.LoginController">
    <padding>
        <javafx.geometry.Insets top="32" right="32" bottom="32" left="32"/>
    </padding>
    <Label text="Hotel4You" styleClass="title"/>
    <Label text="Inicie sessão para continuar" styleClass="subtitle"/>
    <Label text="Nome de utilizador" labelFor="$usernameField" maxWidth="Infinity"/>
    <TextField fx:id="usernameField"/>
    <Label text="Palavra-passe" labelFor="$passwordField" maxWidth="Infinity"/>
    <PasswordField fx:id="passwordField"/>
    <Button text="Entrar" onAction="#onLoginClicked" defaultButton="true"
            maxWidth="Infinity" styleClass="primary-button"/>
    <Label fx:id="messageLabel" wrapText="true" styleClass="message"/>
</VBox>
