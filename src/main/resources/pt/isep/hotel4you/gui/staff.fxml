<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" maxWidth="360" alignment="TOP_LEFT"
      stylesheets="@style.css" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.isep.hotel4you.gui.StaffController">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Criar conta de funcionário" styleClass="subtitle"/>
    <TextField fx:id="nameField" promptText="Nome" maxWidth="Infinity"/>
    <TextField fx:id="usernameField" promptText="Nome de utilizador" maxWidth="Infinity"/>
    <PasswordField fx:id="passwordField" promptText="Palavra-passe" maxWidth="Infinity"/>
    <ComboBox fx:id="roleBox" promptText="Tipo de conta" maxWidth="Infinity"/>
    <Button text="Criar conta" onAction="#onCreateStaffClicked" maxWidth="Infinity"
            styleClass="primary-button"/>
    <Label fx:id="messageLabel" styleClass="message" wrapText="true" maxWidth="Infinity"/>
</VBox>
