<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="screen" spacing="12" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.isep.hotel4you.gui.CheckInOutController">

    <Label text="Reservas ativas" styleClass="subtitle"/>
    <TableView fx:id="reservationTable" accessibleText="Reservas ativas" VBox.vgrow="ALWAYS" prefWidth="500">
        <columns>
            <TableColumn fx:id="roomColumn" text="Quarto" prefWidth="90"/>
            <TableColumn fx:id="startColumn" text="Entrada" prefWidth="120"/>
            <TableColumn fx:id="endColumn" text="Saída" prefWidth="120"/>
            <TableColumn fx:id="statusColumn" text="Estado" prefWidth="140"/>
        </columns>
        <placeholder>
            <Label text="Não há reservas ativas."/>
        </placeholder>
    </TableView>
    <HBox spacing="12">
        <Button fx:id="checkInButton" text="Fazer check-in" onAction="#onCheckInClicked" disable="true"
                styleClass="action-button, save-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="checkOutButton" text="Fazer check-out" onAction="#onCheckOutClicked" disable="true"
                styleClass="action-button, edit-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>
    <Label fx:id="messageLabel" styleClass="message" wrapText="true" maxWidth="Infinity"/>
</VBox>
