<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="30" stylesheets="@style.css" xmlns:fx="http://javafx.com/fxml"
      fx:controller="pt.isep.hotel4you.gui.FloorController">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Floors and search -->
    <VBox spacing="12" prefWidth="280" minWidth="240">
        <Label text="Pisos" styleClass="subtitle" labelFor="$floorList"/>
        <ListView fx:id="floorList" VBox.vgrow="ALWAYS"/>
        <Label text="Número do piso" labelFor="$numberField"/>
        <TextField fx:id="numberField" maxWidth="Infinity"/>
        <Button text="Procurar" onAction="#onSearchClicked" maxWidth="Infinity"
                styleClass="primary-button"/>
        <Label fx:id="messageLabel" styleClass="message" wrapText="true" maxWidth="Infinity"/>
    </VBox>

    <Separator orientation="VERTICAL"/>

    <!-- Zones of the selected floor -->
    <VBox spacing="12" HBox.hgrow="ALWAYS">
        <Label text="Zonas do piso" styleClass="subtitle" labelFor="$locationTable"/>
        <TableView fx:id="locationTable" VBox.vgrow="ALWAYS" prefWidth="500">
            <columns>
                <TableColumn fx:id="nameColumn" text="Zona" prefWidth="180"/>
                <TableColumn fx:id="guestCardColumn" text="Acesso com cartão do cliente" prefWidth="180"/>
                <TableColumn fx:id="reservationColumn" text="Exige reserva" prefWidth="120"/>
            </columns>
            <placeholder>
                <Label text="Selecione um piso com zonas."/>
            </placeholder>
        </TableView>
    </VBox>
</HBox>
